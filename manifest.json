{
  "manifest_version": 3,
  "name": "RealDark",
  "version": "1.0",
  "description": "定时/日出日落自动切换深色模式 — 新标签页 + 网页内容",
  "permissions": ["storage", "geolocation", "alarms", "browserSettings"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "realdark@example.com",
      "strict_min_version": "95.0"
    }
  }
}